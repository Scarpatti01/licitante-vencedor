  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run tipos && npm run lint && npm test",
    "pncp:ingerir": "node scripts/ingerir-pncp.ts",
    "pncp:testar": "node scripts/testar-pncp.ts",
