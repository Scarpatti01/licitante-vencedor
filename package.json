    "db:status": "supabase migration list",
    "alertas:enviar": "node --conditions=react-server scripts/enviar-alertas.ts",
    "alertas:simular": "node --conditions=react-server scripts/enviar-alertas.ts --simular",
    "documentos:extrair": "node scripts/extrair-documentos.ts",
