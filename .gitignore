# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Snapshot completo do PNCP: 3,6 MB por coleta so das 6 UFs piloto. Fica fora
# do versionamento; o cron o publica como artefato da execucao.
/dados/editais.json
/dados/editais-revisao.txt

# Coleta recusada pela guarda de degradacao (ver src/lib/fontes/degradacao.ts).
# Ela e gravada aqui em vez de substituir dados/agregados.json, para um dia ruim
# nao apagar um dia bom. Fica FORA do git de proposito: o versionamento e a
# serie temporal do produto e so dado bom entra nela. O diagnostico vai como
# artefato da execucao, que e onde ele serve.
/dados/parciais/

# Saída de execução dos scripts de agendamento — diagnóstico local, não artefato.
saida-*.txt

# Saída dos scripts de publicação — diagnóstico local, não artefato.
saida-posts.txt
